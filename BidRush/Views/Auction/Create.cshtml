@model BidRush.ViewModels.CreateAuctionViewModel

@{
    ViewData["Title"] = "Create Auction";
}

<div class="auction-create-container">

    <div class="auction-create-header">
        <h1>Create Auction</h1>
        <p>Put an item up for auction and let the bidding begin.</p>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="auction-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Title"></label>

            <input asp-for="Title" class="form-control" placeholder="Enter auction title" />

            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>

            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe the item..."></textarea>

            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Image">Auction Image</label>

            <input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png" />

            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <div class="form-row">

            <div class="form-group">
                <label asp-for="StartingPrice"></label>

                <input asp-for="StartingPrice" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />

                <span asp-validation-for="StartingPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinimumBidIncrement"></label>

                <input asp-for="MinimumBidIncrement" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />

                <span asp-validation-for="MinimumBidIncrement" class="text-danger"></span>
            </div>

        </div>

        <div class="form-row">

            <div class="form-group">
                <label asp-for="StartTime"></label>

                <input asp-for="StartTime" class="form-control" type="datetime-local" />

                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndTime"></label>

                <input asp-for="EndTime" class="form-control" type="datetime-local" />

                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

        </div>

        <div class="form-group">
            <label asp-for="CategoryId">Category</label>

            <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))" class="form-control">

                <option value="">-- Select Category --</option>

            </select>

            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="auction-form-actions">

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                Create Auction
            </button>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}