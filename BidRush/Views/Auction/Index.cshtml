@model BidRush.ViewModels.AuctionIndexViewModel

@{
    ViewData["Title"] = "Auctions";
}

<div class="auction-index-container">

    <div class="auction-index-header">
        <div>
            <h1>Auctions</h1>
            <p>Browse available auctions and find something worth bidding on.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Create Auction
        </a>
    </div>

    <form asp-action="Index" method="get" class="auction-search-form">

        <div class="form-group">
            <label for="search">Search Auctions</label>

            <input type="text"
                   id="search"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Search by title, description, or auction ID..." />
        </div>

        <div class="auction-search-actions">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-action="Index" class="btn btn-secondary">
                    Clear
                </a>
            }
        </div>

    </form>

    @if (!Model.Auctions.Any())
    {
        <div class="auction-empty-state">
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <h3>No auctions found</h3>
                <p>No auctions matched "@Model.Search".</p>
            }
            else
            {
                <h3>No auctions available</h3>
                <p>There are currently no auctions to display.</p>
            }
        </div>
    }
    else
    {
        <div class="auction-grid">

            @foreach (var auction in Model.Auctions)
            {
                <div class="auction-card">

                    @if (!string.IsNullOrWhiteSpace(auction.ImageUrl))
                    {
                        <img src="~/@auction.ImageUrl"
                             alt="@auction.Title"
                             class="auction-card-image" />
                    }
                    else
                    {
                        <div class="auction-card-image-placeholder">
                            No Image
                        </div>
                    }

                    <div class="auction-card-content">

                        <h2>@auction.Title</h2>

                        @if (!string.IsNullOrWhiteSpace(auction.Description))
                        {
                            <p>
                                @auction.Description
                            </p>
                        }

                        <div class="auction-card-details">

                            <div>
                                <span>Starting Price</span>
                                <strong>
                                    @auction.StartingPrice.ToString("N2")
                                </strong>
                            </div>

                            <div>
                                <span>Minimum Increment</span>
                                <strong>
                                    @auction.MinimumBidIncrement.ToString("N2")
                                </strong>
                            </div>

                            <div>
                                <span>Status</span>
                                <strong>
                                    @auction.Status
                                </strong>
                            </div>

                        </div>

                        <div class="auction-card-footer">

                            <span>
                                Ends @auction.EndTime.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </span>

                            <a asp-action="Details"
                               asp-route-id="@auction.Id"
                               class="btn btn-primary">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>