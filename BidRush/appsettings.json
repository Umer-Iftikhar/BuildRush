{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=BidRushDb;Trusted_Connection=true;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "BidRush",
    "Audience": "BidRushUsers",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ImageStorage": {
    "AuctionsFolder": "uploads/auctions",
    "MaxFileSizeBytes": 10485760
  }
}
